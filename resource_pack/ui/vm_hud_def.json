{
    "namespace": "vm",

    "vm_hud_panel": {
        "type": "panel",
        "anchor_from": "top_right",
        "anchor_to": "top_right",
        "size": ["default", "default"],
        "controls": [
            { "vm_bg@vm.vm_bg": {} },
            { "vm_row@vm.vm_row": {} }
        ]
    },

    "vm_bg": {
        "type": "image",
        "texture": "textures/ui/White",
        "size": ["100%c + 10px", "100%c + 6px"],
        "anchor_from": "center",
        "anchor_to": "center",
        "alpha": 0.4,
        "color": [0, 0, 0],
        "layer": 0
    },

    "vm_row": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "anchor_from": "top_right",
        "anchor_to": "top_right",
        "offset": [-6, 4],
        "layer": 1,
        "controls": [
            { "vm_gear@vm.vm_gear_img": {} },
            { "vm_sep@vm.vm_sep_img": {} },
            { "vm_toggle_on@vm.vm_toggle_on_img": {} },
            { "vm_toggle_off@vm.vm_toggle_off_img": {} }
        ]
    },

    "vm_gear_img": {
        "type": "image",
        "texture": "textures/ui/icon_setting",
        "size": [16, 16],
        "offset": [0, 2],
        "color": [0.7, 0.7, 0.7]
    },

    "vm_sep_img": {
        "type": "image",
        "texture": "textures/ui/White",
        "size": [1, 12],
        "color": [0.5, 0.5, 0.5],
        "alpha": 0.4
    },

    "vm_toggle_on_img": {
        "type": "image",
        "texture": "textures/ui/toggle_on",
        "size": [20, 12],
        "offset": [0, 4],
        "color": [0.3, 1.0, 0.3],
        "bindings": [
            {
                "binding_type": "global",
                "binding_name": "#hud_title_text_string"
            },
            {
                "binding_type": "view",
                "source_property_name": "(not ((#hud_title_text_string - 'vm:1') = #hud_title_text_string))",
                "target_property_name": "#visible"
            }
        ]
    },

    "vm_toggle_off_img": {
        "type": "image",
        "texture": "textures/ui/toggle_off",
        "size": [20, 12],
        "offset": [0, 4],
        "color": [0.5, 0.5, 0.5],
        "bindings": [
            {
                "binding_type": "global",
                "binding_name": "#hud_title_text_string"
            },
            {
                "binding_type": "view",
                "source_property_name": "(((#hud_title_text_string - 'vm:1') = #hud_title_text_string))",
                "target_property_name": "#visible"
            }
        ]
    }
}
